# Copy to .env, then fill only the provider(s) you use.
# The CLI loads .env from your current working directory automatically.
# Existing terminal environment variables take precedence over this file.

# Groq
GROQ_API_KEY=
GROQ_CHEAP_MODEL=openai/gpt-oss-20b
# Alternative family; preview model, not a guaranteed middle cost/quality rank.
GROQ_MEDIUM_MODEL=qwen/qwen3.8-27b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Azure Foundry: full inference URL, not the project URL.
AZURE_API_KEY=
AZURE_CHAT_ENDPOINT=
# Suggested deployment names. Deploy the models in Azure or use your actual names.
AZURE_CHEAP_DEPLOYMENT=gpt-4.1-mini
AZURE_MEDIUM_DEPLOYMENT=gpt-5-mini
AZURE_STRONG_DEPLOYMENT=gpt-5
# Actual USD per million tokens for your Azure deployments (not OpenAI API prices).
AZURE_CHEAP_INPUT_USD_PER_MILLION=
AZURE_CHEAP_OUTPUT_USD_PER_MILLION=
AZURE_MEDIUM_INPUT_USD_PER_MILLION=
AZURE_MEDIUM_OUTPUT_USD_PER_MILLION=
AZURE_STRONG_INPUT_USD_PER_MILLION=
AZURE_STRONG_OUTPUT_USD_PER_MILLION=

# Optional installed Ollama model for local inference.
OLLAMA_MODEL=
